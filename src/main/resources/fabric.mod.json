{
  "schemaVersion": 1,
  "id": "maikuaidoufu_masa_tool",
  "version": "${version}",
  "name": "Doufu's Masa Tool",
  "description": "Region-scoped observer suppression with server-synced groups, plus a nether portal travel terminal. The interface runs on MaLiLib, with optional Litematica import.",
  "authors": [
    "Doufu"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cn.maikuaidoufu.MasaToolMod"
    ],
    "client": [
      "cn.maikuaidoufu.client.MasaToolClient"
    ]
  },
  "mixins": [
    "maikuaidoufu_masa_tool.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1",
    "fabric-api-base": ">=2.0.3",
    "fabric-lifecycle-events-v1": ">=4.1.1",
    "fabric-networking-api-v1": ">=6.3.2"
  },
  "recommends": {
    "malilib": ">=0.28.12",
    "litematica": ">=0.27.14"
  },
  "suggests": {
    "syncmatica": "*"
  }
}
